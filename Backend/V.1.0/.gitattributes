# Auto detect text files and perform LF normalization
* text=auto

# Explicit text files that require LF on checkout
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf

# Windows specific scripts
*.cmd text eol=crlf
*.bat text eol=crlf